# ============================================
# Superfluid EUR Streaming - Variables de Entorno
# ============================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo a .env.local
# 2. Completa los valores según tu configuración
# 3. .env.local está en .gitignore y no se subirá al repositorio
#
# cp .env.example .env.local
#

# ============================================
# Configuración de Red (Anvil)
# ============================================

# URL del RPC de Anvil (nodo local)
# Por defecto: http://127.0.0.1:8545
# Cambia solo si Anvil está en otro puerto o host
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545

# Chain ID de Anvil (por defecto 31337)
# Cambia solo si usas un chain ID diferente
NEXT_PUBLIC_CHAIN_ID=31337

# ============================================
# Configuración de Contratos (Opcional)
# ============================================
# 
# NOTA: Las direcciones de contratos están hardcodeadas en web/src/config/web3.ts
# Estas variables permiten sobrescribirlas si es necesario (útil para diferentes entornos)
#
# Si no se configuran, se usarán los valores por defecto de web3.ts

# Dirección del contrato Euro (ERC20)
# NEXT_PUBLIC_EURO_ADDRESS=0x6384D5F8999EaAC8bcCfae137D4e535075b47494

# Dirección del contrato EURx (Super Token)
# NEXT_PUBLIC_EUROX_ADDRESS=0x357f63DB7C18C99051f9507532F426c2A070975a

# ============================================
# Configuración de Alchemy (Para Fork de Mainnet)
# ============================================
#
# Necesario para hacer fork de mainnet en Anvil
# Obtén tu API Key en: https://www.alchemy.com/

# API Key de Alchemy para fork de mainnet
# Usado en el comando: anvil --fork-url https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# ALCHEMY_API_KEY=your_alchemy_api_key_here

# ============================================
# Configuración de Anvil (Opcional - Solo Desarrollo)
# ============================================
#
# Estas variables son para desarrollo local y están hardcodeadas en Dashboard.tsx
# Solo configúralas si necesitas usar diferentes cuentas de Anvil

# Private Key de la cuenta principal de Anvil (primera cuenta por defecto)
# ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Dirección de la cuenta principal de Anvil
# ANVIL_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# ============================================
# Configuración de Superfluid (Opcional)
# ============================================
#
# Las direcciones de Superfluid están hardcodeadas en web/src/config/web3.ts
# Solo configura estas si necesitas usar una red diferente o contratos personalizados

# Resolver de Superfluid
# NEXT_PUBLIC_SUPERFLUID_RESOLVER=0xeE4cD028f5fdaAdeA99f8fc38e8bA8A57c90Be53

# Host de Superfluid
# NEXT_PUBLIC_SUPERFLUID_HOST=0x4E583d9390082B65Bef884b629DFA426114CED6d

# ============================================
# Configuración de Flow Rate (Opcional)
# ============================================
#
# Límites de flow rate (en EUR/mes)
# Por defecto: Mínimo 0.01, Máximo 100,000

# Flow rate mínimo permitido (EUR/mes)
# NEXT_PUBLIC_MIN_FLOW_RATE_MONTHLY=0.01

# Flow rate máximo permitido (EUR/mes)
# NEXT_PUBLIC_MAX_FLOW_RATE_MONTHLY=100000

# Horas de depósito recomendado (por defecto: 8 horas)
# NEXT_PUBLIC_RECOMMENDED_DEPOSIT_HOURS=8

# ============================================
# Configuración de Desarrollo
# ============================================

# Modo de desarrollo (muestra logs adicionales)
# NODE_ENV=development

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# 1. Todas las variables que empiezan con NEXT_PUBLIC_ son accesibles en el cliente
#    (navegador). No pongas información sensible ahí.
#
# 2. Las variables sin NEXT_PUBLIC_ solo están disponibles en el servidor (Next.js)
#
# 3. Para producción, configura estas variables en tu plataforma de hosting
#    (Vercel, Netlify, etc.)
#
# 4. El archivo .env.local está en .gitignore y no se sube al repositorio
#
# 5. Para más información, consulta el README.md
